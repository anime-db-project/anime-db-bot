# =============================================================================
# LIFECYCLE - Process exit policy and automatic restart safeguards
# =============================================================================
# These policies apply to the bot subprocess, not individual HTTP/API errors.
# They are used by start.sh (tmux) and scripts/project.py (run/start/restart).
# Expected operator stop commands and SIGINT/SIGTERM/SIGHUP ALWAYS stop the bot.
# Defaults preserve previous behavior: never restart unexpectedly.
# Install a new/updated active .env.d/lifecycle.env or add unique keys to .env.
# Do not define the same setting in two files.

# -----------------------------------------------------------------------------
# 01. Exit actions
# -----------------------------------------------------------------------------
# What to do after an uncaught fatal error or any non-zero process exit.
# Values: stop | restart
BOT_ON_FAILURE=stop

# What to do after the bot process finishes normally (exit code 0).
# Values: stop | restart
# Use restart only for intentional continuous operation.
BOT_ON_CLEAN_EXIT=stop

# -----------------------------------------------------------------------------
# 02. Automatic restart budget and delay
# -----------------------------------------------------------------------------
# Number of consecutive restarts allowed before stopping.
# 0 disables restarts even when an action is set to restart.
BOT_RESTART_MAX_ATTEMPTS=5

# Delay before the first restart (seconds). Subsequent delays double.
BOT_RESTART_DELAY_SECONDS=5

# Maximum delay in seconds when exponential backoff is active.
BOT_RESTART_MAX_DELAY_SECONDS=60

# Reset the consecutive restart count after the bot stays alive this long.
# This avoids permanently exhausting a budget after a long healthy period.
BOT_RESTART_RESET_AFTER_SECONDS=300

# -----------------------------------------------------------------------------
# 03. Graceful shutdown
# -----------------------------------------------------------------------------
# Time allowed for the bot to finish shutdown after a supervisor stop signal.
# After this timeout the subprocess is killed.
BOT_SHUTDOWN_TIMEOUT_SECONDS=10
