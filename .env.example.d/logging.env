# =============================================================================
# logging.env - Log format, rotation and retention
# =============================================================================
# English is the project's default documentation and configuration language.
# Template only; copy desired keys to .env.d/logging.env and restart the bot.
# Do not define the same key in both .env and .env.d files.

# -----------------------------------------------------------------------------
# 01. Log severity and privacy
# -----------------------------------------------------------------------------
# Choose output detail and ensure sensitive values are redacted.
# Minimum log severity: DEBUG, INFO, WARNING, ERROR, etc.
LOG_LEVEL=INFO
# Enable structured log output (1 = yes, 0 = no).
LOG_STRUCTURED=1
# Redact tokens, passwords and other secrets in logs.
LOG_REDACT_SECRETS=1

# -----------------------------------------------------------------------------
# 02. Log files and retention
# -----------------------------------------------------------------------------
# Bound log directory growth through rotation and retention settings.
# Directory in which dated log files are written.
LOG_DIR=logs
# Maximum log file size before rotation, in bytes.
LOG_MAX_BYTES=10485760
# Number of rotated log backups to retain.
LOG_BACKUPS=5
# Maximum log retention period, in days.
LOG_RETENTION_DAYS=30
