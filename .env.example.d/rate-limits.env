# =============================================================================
# RATE LIMITS - Per-user and provider request budgets
# =============================================================================
# All UPSTREAM_RATE_LIMIT_*_PER_MINUTE values count requests per minute.
# These local settings do not override external service safety policies.
# Template only. Copy desired values to .env.d/rate-limits.env.

# -----------------------------------------------------------------------------
# 01. User request budgets
# -----------------------------------------------------------------------------
# Per-user limits are independent of API provider limits; users and admins cannot bypass upstream provider safety budgets.
# Maximum requests allowed from one user per minute.
USER_RATE_LIMIT_PER_MINUTE=50
# Maximum requests allowed from one user per hour.
USER_RATE_LIMIT_PER_HOUR=1000

# -----------------------------------------------------------------------------
# 02. Default upstream budget
# -----------------------------------------------------------------------------
# Fallback budget for operations without their own configured rate limit.
# Default upstream request budget per minute when no specific budget applies.
UPSTREAM_RATE_LIMIT_DEFAULT_PER_MINUTE=120

# -----------------------------------------------------------------------------
# 03. MAL and Jikan
# -----------------------------------------------------------------------------
# Separate general and operation-specific request budgets.
# Maximum MyAnimeList requests per minute.
UPSTREAM_RATE_LIMIT_MAL_PER_MINUTE=120
# Maximum Jikan requests per minute.
UPSTREAM_RATE_LIMIT_JIKAN_PER_MINUTE=30
# Maximum Jikan metadata requests per minute.
UPSTREAM_RATE_LIMIT_JIKAN_METADATA_PER_MINUTE=20
# Maximum Jikan people requests per minute.
UPSTREAM_RATE_LIMIT_JIKAN_PEOPLE_PER_MINUTE=15
# Maximum Jikan trailers requests per minute.
UPSTREAM_RATE_LIMIT_JIKAN_TRAILERS_PER_MINUTE=15
# Maximum Jikan episodes requests per minute.
UPSTREAM_RATE_LIMIT_JIKAN_EPISODES_PER_MINUTE=20

# -----------------------------------------------------------------------------
# 04. AniList
# -----------------------------------------------------------------------------
# General and people-specific budgets.
# Maximum AniList requests per minute.
UPSTREAM_RATE_LIMIT_ANILIST_PER_MINUTE=80
# Maximum AniList people requests per minute.
UPSTREAM_RATE_LIMIT_ANILIST_PEOPLE_PER_MINUTE=20

# -----------------------------------------------------------------------------
# 05. Shikimori
# -----------------------------------------------------------------------------
# General and people-specific budgets.
# Maximum Shikimori requests per minute.
UPSTREAM_RATE_LIMIT_SHIKIMORI_PER_MINUTE=240
# Maximum Shikimori people requests per minute.
UPSTREAM_RATE_LIMIT_SHIKIMORI_PEOPLE_PER_MINUTE=60

# -----------------------------------------------------------------------------
# 06. Kitsu
# -----------------------------------------------------------------------------
# Search, episode and trailer requests may have separate budgets.
# Maximum Kitsu requests per minute.
UPSTREAM_RATE_LIMIT_KITSU_PER_MINUTE=60
# Maximum Kitsu search requests per minute.
UPSTREAM_RATE_LIMIT_KITSU_SEARCH_PER_MINUTE=60
# Maximum Kitsu episodes requests per minute.
UPSTREAM_RATE_LIMIT_KITSU_EPISODES_PER_MINUTE=60
# Maximum Kitsu trailers requests per minute.
UPSTREAM_RATE_LIMIT_KITSU_TRAILERS_PER_MINUTE=60

# -----------------------------------------------------------------------------
# 07. AniDB
# -----------------------------------------------------------------------------
# General AniDB request budget.
# Maximum AniDB requests per minute.
UPSTREAM_RATE_LIMIT_ANIDB_PER_MINUTE=20

# -----------------------------------------------------------------------------
# 08. AniSearch
# -----------------------------------------------------------------------------
# General and heavy operation budgets; provider-side pacing still applies.
# Maximum AniSearch requests per minute.
UPSTREAM_RATE_LIMIT_ANISEARCH_PER_MINUTE=12
# Maximum AniSearch people requests per minute.
UPSTREAM_RATE_LIMIT_ANISEARCH_PEOPLE_PER_MINUTE=12
# Maximum AniSearch episodes requests per minute.
UPSTREAM_RATE_LIMIT_ANISEARCH_EPISODES_PER_MINUTE=12

# -----------------------------------------------------------------------------
# 09. SkipDB (inactive)
# -----------------------------------------------------------------------------
# Retained for the dormant SkipDB provider; no SkipDB runtime traffic is enabled by these values.
# Maximum SkipDB requests per minute.
UPSTREAM_RATE_LIMIT_SKIPDB_PER_MINUTE=30
# Maximum SkipDB identity requests per minute.
UPSTREAM_RATE_LIMIT_SKIPDB_IDENTITY_PER_MINUTE=30
# Maximum SkipDB episode lists requests per minute.
UPSTREAM_RATE_LIMIT_SKIPDB_EPISODES_PER_MINUTE=30
# Maximum SkipDB single-episode calls requests per minute.
UPSTREAM_RATE_LIMIT_SKIPDB_EPISODE_PER_MINUTE=120

# -----------------------------------------------------------------------------
# 10. Anime Skip
# -----------------------------------------------------------------------------
# General API and episode skip-segment budgets.
# Maximum Anime Skip requests per minute.
UPSTREAM_RATE_LIMIT_ANIME_SKIP_PER_MINUTE=60
# Maximum Anime Skip episode skip-segments requests per minute.
UPSTREAM_RATE_LIMIT_ANIME_SKIP_EPISODE_SEGMENTS_PER_MINUTE=60

# -----------------------------------------------------------------------------
# 11. AnimeThemes
# -----------------------------------------------------------------------------
# General and theme metadata budgets.
# Maximum AnimeThemes requests per minute.
UPSTREAM_RATE_LIMIT_ANIMETHEMES_PER_MINUTE=30
# Maximum AnimeThemes themes requests per minute.
UPSTREAM_RATE_LIMIT_ANIMETHEMES_THEMES_PER_MINUTE=30

# -----------------------------------------------------------------------------
# 12. trace.moe
# -----------------------------------------------------------------------------
# Quota checks and image recognition use separate operation budgets.
# Maximum trace.moe requests per minute.
UPSTREAM_RATE_LIMIT_TRACE_MOE_PER_MINUTE=30
# Maximum trace.moe quota queries requests per minute.
UPSTREAM_RATE_LIMIT_TRACE_MOE_QUOTA_PER_MINUTE=30
# Maximum trace.moe image matching requests per minute.
UPSTREAM_RATE_LIMIT_TRACE_MOE_IMAGE_SEARCH_PER_MINUTE=20

# -----------------------------------------------------------------------------
# 13. What Anime Is This
# -----------------------------------------------------------------------------
# General and image recognition operation budgets.
# Maximum What Anime Is This requests per minute.
UPSTREAM_RATE_LIMIT_WHATANIMEISTHIS_PER_MINUTE=10
# Maximum What Anime Is This image matching requests per minute.
UPSTREAM_RATE_LIMIT_WHATANIMEISTHIS_IMAGE_SEARCH_PER_MINUTE=10

# -----------------------------------------------------------------------------
# 14. IMDb ratings
# -----------------------------------------------------------------------------
# General and ratings lookup budgets.
# Maximum IMDb requests per minute.
UPSTREAM_RATE_LIMIT_IMDB_PER_MINUTE=30
# Maximum IMDb ratings requests per minute.
UPSTREAM_RATE_LIMIT_IMDB_RATINGS_PER_MINUTE=30
