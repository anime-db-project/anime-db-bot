# =============================================================================
# runtime.env - Search, HTTP, cache and provider-health settings
# =============================================================================
# Template only. Copy desired settings to .env.d/runtime.env.
# Existing .env files remain supported; do not declare a key twice.
# All explanations use English. Restart after changing active configuration.

# -----------------------------------------------------------------------------
# 01. Search providers
# -----------------------------------------------------------------------------
# Controls the default text search; manually selected sources remain available.
# Comma-separated defaults: shikimori, mal, anilist and/or kitsu.
SEARCH_DEFAULT_PROVIDERS=shikimori,mal,anilist,kitsu
# Enable cross-language expansion queries; disabling saves API work.
SEARCH_EXPANSION_ENABLED=true

# -----------------------------------------------------------------------------
# 02. Search pagination and expansion
# -----------------------------------------------------------------------------
# Bounds for candidate collection, filtering and optional cross-language queries.
# Number of candidates per collection page.
SEARCH_COLLECTION_PAGE_SIZE=20
# Maximum pages examined in one collection.
SEARCH_COLLECTION_MAX_PAGES=4
# Maximum collected candidate count.
SEARCH_COLLECTION_MAX_ITEMS=120
# Minimum relevance score for result selection.
SEARCH_RELEVANCE_THRESHOLD=55
# Low-relevance trailing pages still considered.
SEARCH_IRRELEVANT_TAIL_PAGES=1
# Maximum search results used as expansion seeds.
SEARCH_EXPANSION_MAX_SEEDS=1
# Maximum additional expansion queries.
SEARCH_EXPANSION_MAX_QUERIES=1
# Maximum pages explored during expansion.
SEARCH_EXPANSION_MAX_PAGES=2

# -----------------------------------------------------------------------------
# 03. In-memory search caches
# -----------------------------------------------------------------------------
# Caps RAM consumption. Smaller values may result in more API calls.
# Lifetime of cached search results, in seconds.
SEARCH_CACHE_TTL_SECONDS=21600
# Maximum entries per in-memory search cache.
SEARCH_CACHE_MAX_ENTRIES=500
# Approximate byte limit for each search cache.
SEARCH_CACHE_MAX_BYTES=4194304
# Maximum cached SearchService provider combinations.
SEARCH_PROVIDER_SERVICE_CACHE_ENTRIES=6

# -----------------------------------------------------------------------------
# 04. Optional Redis cache
# -----------------------------------------------------------------------------
# Only successful search results are cached. Redis outages fall back to the local cache; this is not full multi-instance clustering.
# Example: REDIS_URL=redis://:password@127.0.0.1:6379/0
# Search result cache: memory (default) or redis.
CACHE_BACKEND=memory
# Redis connection URL; only required when enabled. Keep credentials private.
REDIS_URL=
# Namespace prefix for Redis cache entries.
REDIS_KEY_PREFIX=anime-db-bot
# Redis operation timeout, in seconds.
REDIS_TIMEOUT_SECONDS=0.25
# Maximum Redis pool connections.
REDIS_MAX_CONNECTIONS=10
# How long to bypass unavailable Redis, in seconds.
REDIS_FAILURE_COOLDOWN_SECONDS=20

# -----------------------------------------------------------------------------
# 05. Provider health
# -----------------------------------------------------------------------------
# Cooldown unhealthy upstream sources after repeated request failures.
# Number of failures before entering provider cooldown.
SOURCE_HEALTH_FAILURE_THRESHOLD=3
# Cooldown duration for failing sources, in seconds.
SOURCE_HEALTH_COOLDOWN_SECONDS=30

# -----------------------------------------------------------------------------
# 06. Shared HTTP client pool
# -----------------------------------------------------------------------------
# Upper bounds for in-flight requests and pooled connections.
# Maximum shared HTTP requests running at once.
HTTP_MAX_CONCURRENT_REQUESTS=48
# Maximum total pooled HTTP connections.
HTTP_MAX_CONNECTIONS=48
# Maximum idle keep-alive connections; cannot exceed the total.
HTTP_MAX_KEEPALIVE_CONNECTIONS=24
# Idle connection expiration in seconds.
HTTP_KEEPALIVE_EXPIRY_SECONDS=5
