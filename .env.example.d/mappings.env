# =============================================================================
# mappings.env - Mapping dataset consumption
# =============================================================================
# English is the project's default documentation and configuration language.
# Template only; copy desired keys to .env.d/mappings.env and restart the bot.
# Do not define the same key in both .env and .env.d files.

# -----------------------------------------------------------------------------
# 01. Mapping DB local files
# -----------------------------------------------------------------------------
# The bot reads the independently produced Anime Mapping DB catalog; it does not build that dataset.
# Local mapping SQLite catalog path.
MAPPINGS_DB_PATH=data/mappings/mappings.db
# Local mapping release manifest path.
MAPPINGS_MANIFEST_PATH=data/mappings/manifest.json
# GitHub owner/repository for Anime Mapping DB releases.
MAPPINGS_RELEASE_REPOSITORY=anime-db-project/anime-mapping-db

# -----------------------------------------------------------------------------
# 02. Automatic update behavior
# -----------------------------------------------------------------------------
# Control release checks, download timeout and optional rollback retention.
# Automatically fetch mapping updates (1 = enabled, 0 = disabled).
MAPPINGS_AUTO_UPDATE=1
# Time between mapping release checks, in seconds.
MAPPINGS_CHECK_INTERVAL_SECONDS=3600
# Mapping download/check timeout, in seconds.
MAPPINGS_REQUEST_TIMEOUT_SECONDS=300
# Retain the previous mapping dataset for rollback (1 = yes).
MAPPINGS_KEEP_PREVIOUS=1
