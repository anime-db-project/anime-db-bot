# =============================================================================
# sources.env - Anime metadata sources and optional supplements
# =============================================================================
# Template only. Copy desired settings to .env.d/sources.env.
# Existing .env files remain supported; do not declare a key twice.
# All explanations use English. Restart after changing active configuration.

# -----------------------------------------------------------------------------
# 01. MyAnimeList (MAL)
# -----------------------------------------------------------------------------
# Official MAL integration; Jikan below is a supplement under the same MAL identity.
# Official MyAnimeList API client ID.
MAL_CLIENT_ID=
# MyAnimeList API endpoint URL.
MAL_API_URL=https://api.myanimelist.net/v2

# -----------------------------------------------------------------------------
# 02. Jikan
# -----------------------------------------------------------------------------
# Optional local Jikan service with separate metadata and people cache controls.
# Jikan API endpoint URL.
JIKAN_API_URL=http://127.0.0.1:8091
# Port for the optional local Jikan service.
JIKAN_PORT=8091
# Jikan upstream request timeout, in seconds.
JIKAN_REQUEST_TIMEOUT_SECONDS=45
# Jikan cache lifetime, in seconds.
JIKAN_SUPPLEMENT_CACHE_TTL_SECONDS=21600
# Jikan cache lifetime, in seconds.
JIKAN_PEOPLE_CACHE_TTL_SECONDS=21600
# Maximum number of Jikan cached items.
JIKAN_CACHE_MAX_ENTRIES=1000

# -----------------------------------------------------------------------------
# 03. Shikimori
# -----------------------------------------------------------------------------
# GraphQL source, site links and bounded people enrichment.
# Shikimori API endpoint URL.
SHIKIMORI_API_URL=https://shikimori.io/api/graphql
# Shikimori website URL for outgoing links.
SHIKIMORI_SITE_URL=https://shikimori.io
# Shikimori cache lifetime, in seconds.
SHIKIMORI_PEOPLE_CACHE_TTL_SECONDS=21600
# Characters processed in a Shikimori people batch.
SHIKIMORI_PEOPLE_CHARACTER_BATCH_SIZE=8
# Minimum interval between Shikimori REST requests, in seconds.
SHIKIMORI_REST_MIN_INTERVAL_SECONDS=0.24

# -----------------------------------------------------------------------------
# 04. AniList
# -----------------------------------------------------------------------------
# GraphQL source and paginated cast/staff enrichment.
# AniList API endpoint URL.
ANILIST_API_URL=https://graphql.anilist.co
# Optional AniList access token; keep private.
ANILIST_ACCESS_TOKEN=
# Maximum AniList staff/cast/character pages (25 records per page).
# 12 avoids stopping at 100 when an anime has more than 141 contributors.
# The loader stops earlier as soon as AniList reports no further pages.
ANILIST_PEOPLE_MAX_PAGES=12
# AniList cache lifetime, in seconds.
ANILIST_PEOPLE_CACHE_TTL_SECONDS=21600

# -----------------------------------------------------------------------------
# 05. Kitsu
# -----------------------------------------------------------------------------
# Read-only metadata, search and episode source.
# Kitsu API endpoint URL.
KITSU_API_URL=https://kitsu.io/api/edge
# Kitsu upstream request timeout, in seconds.
KITSU_REQUEST_TIMEOUT_SECONDS=20
# Kitsu cache lifetime, in seconds.
KITSU_CACHE_TTL_SECONDS=21600

# -----------------------------------------------------------------------------
# 06. AniDB
# -----------------------------------------------------------------------------
# Optional AniDB client identification and local response caching.
# Registered AniDB client identifier; empty disables client-dependent integration.
ANIDB_CLIENT=
# Registered AniDB client version.
ANIDB_CLIENT_VERSION=1
# AniDB API endpoint URL.
ANIDB_HTTP_API_URL=http://api.anidb.net:9001/httpapi
# AniDB upstream request timeout, in seconds.
ANIDB_REQUEST_TIMEOUT_SECONDS=45
# Local directory for cached AniDB responses.
ANIDB_CACHE_DIR=data/anidb
# AniDB cache lifetime, in seconds.
ANIDB_CACHE_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# 07. AniSearch
# -----------------------------------------------------------------------------
# Localized title metadata and people. Keep application credentials secret.
# AniSearch API endpoint URL.
ANISEARCH_API_URL=https://api.anisearch.com
# AniSearch application ID.
ANISEARCH_APP_ID=
# AniSearch application secret; keep private.
ANISEARCH_APP_SECRET=
# AniSearch upstream request timeout, in seconds.
ANISEARCH_REQUEST_TIMEOUT_SECONDS=30
# AniSearch cache lifetime, in seconds.
ANISEARCH_CACHE_TTL_SECONDS=21600
# AniSearch cache budget, in bytes.
ANISEARCH_CACHE_MAX_BYTES=16777216
# Maximum number of AniSearch cached items.
ANISEARCH_CACHE_MAX_ENTRIES=750
# Interactive wait budget for AniSearch data, in seconds.
ANISEARCH_INTERACTIVE_WAIT_SECONDS=0.75

# -----------------------------------------------------------------------------
# 08. SkipDB (inactive)
# -----------------------------------------------------------------------------
# These settings are retained for a dormant provider, not active runtime network access.
# SkipDB API endpoint URL.
SKIPDB_API_URL=https://skipdb.tv
# SkipDB website URL for outgoing links.
SKIPDB_SITE_URL=https://skipdb.tv
# SkipDB upstream request timeout, in seconds.
SKIPDB_REQUEST_TIMEOUT_SECONDS=20
# SkipDB cache lifetime, in seconds.
SKIPDB_CACHE_TTL_SECONDS=21600

# -----------------------------------------------------------------------------
# 09. IMDb ratings
# -----------------------------------------------------------------------------
# Modes: auto (licensed API with local fallback), local (filtered SQLite), api (licensed GraphQL), off. Never infer IMDb identity from TVDB/TMDB chains.
# IMDb ratings source: auto, local, api or off.
IMDB_RATINGS_BACKEND=auto
# Path to the filtered IMDb ratings SQLite index.
IMDB_RATINGS_DB_PATH=data/imdb_ratings.sqlite3
# Licensed IMDb GraphQL endpoint via AWS Data Exchange.
IMDB_API_ENDPOINT=https://api-fulfill.dataexchange.us-east-1.amazonaws.com/v1
# Licensed IMDb API key; keep private.
IMDB_API_KEY=
# AWS Data Exchange dataset ID.
IMDB_API_DATA_SET_ID=
# AWS Data Exchange revision ID.
IMDB_API_REVISION_ID=
# AWS Data Exchange asset ID.
IMDB_API_ASSET_ID=
# AWS access key for signed requests.
IMDB_AWS_ACCESS_KEY_ID=
# AWS secret key; keep private.
IMDB_AWS_SECRET_ACCESS_KEY=
# Optional AWS session token.
IMDB_AWS_SESSION_TOKEN=
# AWS region used when signing licensed IMDb requests.
IMDB_AWS_REGION=us-east-1
# IMDb upstream request timeout, in seconds.
IMDB_REQUEST_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# 10. trace.moe
# -----------------------------------------------------------------------------
# Optional image recognition with guest/account quota handling.
# trace.moe API endpoint URL.
TRACE_MOE_API_URL=https://api.trace.moe
# Optional trace.moe API key.
TRACE_MOE_API_KEY=
# trace.moe upstream request timeout, in seconds.
TRACE_MOE_REQUEST_TIMEOUT_SECONDS=30
# trace.moe cache lifetime, in seconds.
TRACE_MOE_QUOTA_CACHE_TTL_SECONDS=30
# Crop borders from submitted images before matching.
TRACE_MOE_CUT_BORDERS=true

# -----------------------------------------------------------------------------
# 11. What Anime Is This
# -----------------------------------------------------------------------------
# Another image recognition backend; guest and authenticated quotas differ.
# What Anime Is This API endpoint URL.
WHATANIMEISTHIS_API_URL=https://whatanimeisthis.com
# Optional What Anime Is This API key.
WHATANIMEISTHIS_API_KEY=
# What Anime Is This upstream request timeout, in seconds.
WHATANIMEISTHIS_REQUEST_TIMEOUT_SECONDS=30
# Local maximum daily guest requests.
WHATANIMEISTHIS_GUEST_DAILY_LIMIT=5
# Local maximum daily API-key requests; zero disables this local ceiling.
WHATANIMEISTHIS_API_DAILY_LIMIT=10

# -----------------------------------------------------------------------------
# 12. Shared image-search safety
# -----------------------------------------------------------------------------
# Maximum accepted image-search payload size.
# Maximum input size for reverse image search, in bytes.
IMAGE_SEARCH_MAX_BYTES=20971520

# -----------------------------------------------------------------------------
# 13. People loading
# -----------------------------------------------------------------------------
# Bounded batches and concurrency for staff and voice portraits.
# Maximum portrait candidates per enrichment batch.
PEOPLE_PORTRAIT_BATCH_SIZE=50
# Concurrent lightweight staff/cast manifest loads.
PEOPLE_MANIFEST_CONCURRENCY=12
# Concurrent portrait image loads.
PEOPLE_PORTRAIT_CONCURRENCY=8
