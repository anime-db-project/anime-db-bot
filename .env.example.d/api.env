# =============================================================================
# API - Authenticated REST /api/v1 and GraphQL /graphql
# =============================================================================
# Optional: API_ENABLED=true starts HTTP alongside Telegram polling.
# You can also launch an API-only instance using "anime-db-bot api".
# Defaults keep the HTTP listener OFF and bound to loopback.
# Keys/passwords belong in a private .env file or process environment.
# Do NOT expose the admin API directly on the public Internet.

# 01. Listener and external proxy URL
API_ENABLED=false
API_HOST=127.0.0.1
API_PORT=8181
# Informational absolute public HTTPS URL; does not change the bind address.
API_PUBLIC_URL=
# Reverse proxy addresses are not automatically trusted for identity/auth.
API_TRUST_PROXY=false

# 02. Authentication
# apikey | basic | local
# local mode is allowed ONLY on a loopback bind and from a loopback peer.
API_AUTH_MODE=apikey
# Distinct random secrets, each 24+ characters; neither is returned by the API.
# Read key: discovery/queries only. Admin key: all endpoints/mutations.
API_READ_KEY=
API_ADMIN_KEY=
# For basic auth: HTTP Basic username and password (24+ characters).
API_BASIC_USERNAME=
API_BASIC_PASSWORD=

# 03. Browser origin policy
# Comma-separated, exact origins (scheme + host + optional port), no wildcards.
# Leave empty to disable cross-origin browser requests.
API_CORS_ORIGINS=

# 04. Resource and abuse limits
API_REQUESTS_PER_MINUTE=90
API_MAX_CONCURRENCY=12
API_MAX_BODY_BYTES=4194304
API_TIMEOUT_SECONDS=30

# 05. GraphQL limits and development tools
API_GRAPHQL_MAX_DEPTH=8
API_GRAPHQL_MAX_FIELDS=60
# Disable introspection when exposing GraphQL outside a trusted LAN.
API_GRAPHQL_INTROSPECTION=true
