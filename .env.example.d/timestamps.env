# =============================================================================
# timestamps.env - Episode skip segments and OP/ED enrichment
# =============================================================================
# English is the project's default documentation and configuration language.
# Template only; copy desired keys to .env.d/timestamps.env and restart the bot.
# Do not define the same key in both .env and .env.d files.

# -----------------------------------------------------------------------------
# 01. Anime Skip API
# -----------------------------------------------------------------------------
# Episode-relative skip ranges. Keep the client ID private to protect its quota.
# Anime Skip API base URL.
ANIME_SKIP_API_URL=https://anime-skip.com/api
# Anime Skip API client ID; keep private.
ANIME_SKIP_CLIENT_ID=
# Anime Skip API request timeout, in seconds.
ANIME_SKIP_REQUEST_TIMEOUT_SECONDS=20
# Anime Skip segment cache lifetime, in seconds.
ANIME_SKIP_CACHE_TTL_SECONDS=21600

# -----------------------------------------------------------------------------
# 02. AnimeThemes
# -----------------------------------------------------------------------------
# OP/ED metadata enrichment for episodes; not an independent anime identity database.
# AnimeThemes API base URL.
ANIMETHEMES_API_URL=https://api.animethemes.moe
# AnimeThemes API request timeout, in seconds.
ANIMETHEMES_REQUEST_TIMEOUT_SECONDS=15
# AnimeThemes theme metadata cache lifetime, in seconds.
ANIMETHEMES_CACHE_TTL_SECONDS=21600

# -----------------------------------------------------------------------------
# 03. Baha Anime Skip local index
# -----------------------------------------------------------------------------
# The bot reads skip intervals from local SQLite. Remote Baha URLs are for the separate index builder/refresh only.
# Bahamut API URL for index update tooling, not runtime lookups.
BAHAMUT_API_URL=https://api.gamer.com.tw/mobile_app/anime
# Bahamut fetch timeout for index updates, in seconds.
BAHAMUT_REQUEST_TIMEOUT_SECONDS=20
# Public source file used to build/refresh the local skip index.
BAHA_ANIME_SKIP_DATA_URL=https://raw.githubusercontent.com/JacobLinCool/baha-anime-skip/main/packages/baha-anime-skip-db/data.json
# Local SQLite path for Baha skip timestamps.
BAHA_ANIME_SKIP_DB_PATH=data/baha_anime_skip.sqlite3
