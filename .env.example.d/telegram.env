# Telegram transport, sessions and administrator accounts.
# Keep BOT_TOKEN private.

BOT_TOKEN=
ADMIN_TELEGRAM_USER_IDS=
TELEGRAM_BOT_API_URL=
TELEGRAM_BOT_API_LOCAL=false
# Host path that corresponds to /var/lib/telegram-bot-api inside a local Bot API container.
# Leave empty when the bot process can access the returned file_path directly.
TELEGRAM_BOT_API_LOCAL_FILE_ROOT=
TELEGRAM_SESSION_TTL_SECONDS=3600
ANIME_INPUT_TTL_SECONDS=300

# Rich media: order may contain direct,url,ram,disk (comma separated).
# Remove a method to disable it. If all image methods fail, Telegram still
# gets a rich message WITHOUT images, preserving tables and embedded buttons.
# Standard sendMessage is only used if media-free rich formatting itself fails.
RICH_MEDIA_ORDER=direct,url,ram,disk
RICH_MEDIA_RAM_ENABLED=true
RICH_MEDIA_DISK_ENABLED=true
# Caps for the last-resort server-side image methods (bytes and seconds).
RICH_MEDIA_MAX_IMAGES=8
RICH_MEDIA_MAX_IMAGE_BYTES=4194304
RICH_MEDIA_RAM_CACHE_BYTES=67108864
RICH_MEDIA_DISK_CACHE_BYTES=268435456
RICH_MEDIA_CACHE_TTL_SECONDS=86400
RICH_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=3
RICH_MEDIA_TOTAL_TIMEOUT_SECONDS=7
RICH_MEDIA_MAX_DOWNLOADS=8
RICH_MEDIA_MAX_LOCAL_DELIVERIES=2
# Must be inside project directory; data/runtime/ is git-ignored.
RICH_MEDIA_DISK_DIR=data/runtime/rich-media
