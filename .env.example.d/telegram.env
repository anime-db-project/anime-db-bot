# =============================================================================
# TELEGRAM - Bot access, sessions and rich-media delivery
# =============================================================================
# Copy selected settings to .env.d/telegram.env; never commit real credentials.
# Restart the bot after changing active settings. Time values use seconds.

# -----------------------------------------------------------------------------
# 01. Bot identity and access
# -----------------------------------------------------------------------------
# Configure administrators and optional allowlisting. An empty allowlist permits everyone; administrators are not exempt.
# Example: TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
# Bot token issued by BotFather. Keep private.
BOT_TOKEN=
# Comma-separated Telegram user IDs with administrative access.
ADMIN_TELEGRAM_USER_IDS=
# Allowed Telegram user IDs (comma, semicolon or space separated). Empty permits everyone.
TELEGRAM_ALLOWED_USER_IDS=
# Reply text for users outside the allowlist.
TELEGRAM_DENIED_MESSAGE="Доступ к боту ограничен."
# Minimum time between denial replies to the same user, in seconds.
TELEGRAM_DENIED_REPLY_COOLDOWN_SECONDS=60
# Global maximum number of denial replies per minute.
TELEGRAM_DENIED_GLOBAL_REPLIES_PER_MINUTE=20
# Maximum blocked user IDs tracked for cooldowns.
TELEGRAM_DENIED_MAX_TRACKED_USERS=4096

# -----------------------------------------------------------------------------
# 02. Telegram Bot API transport
# -----------------------------------------------------------------------------
# Leave the URL empty for Telegram's official Bot API. Local mode is for a self-hosted Bot API server.
# Optional self-hosted Bot API base URL; empty selects the official endpoint.
TELEGRAM_BOT_API_URL=
# Enable local Bot API mode with local file paths.
TELEGRAM_BOT_API_LOCAL=false
# Host path mapping of /var/lib/telegram-bot-api; empty if Bot API paths are directly accessible.
TELEGRAM_BOT_API_LOCAL_FILE_ROOT=
# Maximum simultaneous Telegram update handlers.
TELEGRAM_MAX_CONCURRENT_UPDATES=64

# -----------------------------------------------------------------------------
# 03. Interactive sessions and memory limits
# -----------------------------------------------------------------------------
# Lower limits use less RAM but can expire existing menus, search results and cards sooner.
# Callback session expiration, in seconds.
TELEGRAM_SESSION_TTL_SECONDS=3600
# Maximum retained anime card sessions.
TELEGRAM_MAX_CARD_SESSIONS=256
# Maximum retained staff and voice cast sessions.
TELEGRAM_MAX_PEOPLE_SESSIONS=256
# Maximum retained search sessions.
# Shared selection window size. Valid range: 1–30.
TELEGRAM_PAGINATION_PAGE_SIZE=10
# Maximum amount of long-form text revealed per click (200–30000).
# Telegram sendMessage/sendRichMessage limits still take precedence.
TELEGRAM_LONG_TEXT_CHUNK_SIZE=4000
# Optional per-block overrides (1–30). Leave blank to inherit the shared size.
# Search keeps its classic compact number grid, not the named-card chooser.
TELEGRAM_PAGINATION_WIKIPEDIA_PAGE_SIZE=
TELEGRAM_PAGINATION_SETTINGS_PAGE_SIZE=
TELEGRAM_PAGINATION_SEARCH_PAGE_SIZE=
TELEGRAM_PAGINATION_EPISODES_PAGE_SIZE=
TELEGRAM_PAGINATION_CHARACTERS_PAGE_SIZE=
TELEGRAM_PAGINATION_STAFF_PAGE_SIZE=
TELEGRAM_PAGINATION_VOICES_PAGE_SIZE=
TELEGRAM_PAGINATION_RELATED_PAGE_SIZE=
TELEGRAM_PAGINATION_RECOMMENDATIONS_PAGE_SIZE=
TELEGRAM_PAGINATION_TRAILERS_PAGE_SIZE=
TELEGRAM_PAGINATION_SCREENSHOTS_PAGE_SIZE=
TELEGRAM_PAGINATION_TITLES_PAGE_SIZE=
TELEGRAM_PAGINATION_POPULARITY_PAGE_SIZE=
TELEGRAM_PAGINATION_DESCRIPTIONS_PAGE_SIZE=
TELEGRAM_PAGINATION_SOURCE_IDS_PAGE_SIZE=
TELEGRAM_MAX_SEARCH_SESSIONS=192
# Maximum retained source-selection sessions.
TELEGRAM_MAX_SCOPE_SESSIONS=400
# Maximum pending text-input requests.
TELEGRAM_MAX_PENDING_INPUTS=500
# Maximum pending image-input requests.
TELEGRAM_MAX_IMAGE_INPUTS=100
# How long to wait for anime search input, in seconds.
ANIME_INPUT_TTL_SECONDS=300
# Maximum pending administrator confirmations.
TELEGRAM_ADMIN_PENDING_SESSIONS=128
# Expiration for pending administrator confirmations, in seconds.
TELEGRAM_ADMIN_PENDING_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# 04. Search and timestamp timing
# -----------------------------------------------------------------------------
# Time budgets for optional search and timestamp enrichment.
# Maximum wait for optional search expansion, in seconds.
TELEGRAM_SEARCH_EXPANSION_TIMEOUT_SECONDS=8
# Initial wait for skip timestamps before rendering, in seconds.
TELEGRAM_INITIAL_TIMECODE_WAIT_SECONDS=0.15

# -----------------------------------------------------------------------------
# 05. Incoming image limits
# -----------------------------------------------------------------------------
# Guardrails when users submit images for anime recognition.
# Incoming image download timeout, in seconds.
TELEGRAM_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=45
# Maximum decoded image size, measured in pixels.
TELEGRAM_IMAGE_MAX_PIXELS=50000000
# Maximum accepted image width or height, in pixels.
TELEGRAM_IMAGE_MAX_DIMENSION=4096

# -----------------------------------------------------------------------------
# 06. Rich media delivery
# -----------------------------------------------------------------------------
# Fallback order supports direct, url, ram and disk. If images fail, retain rich text/buttons whenever possible.
# Comma-separated delivery fallback methods, evaluated in order.
RICH_MEDIA_ORDER=direct,url,ram,disk
# Allow a RAM-based image upload fallback.
RICH_MEDIA_RAM_ENABLED=true
# Allow a disk-based image upload fallback.
RICH_MEDIA_DISK_ENABLED=true
# Maximum number of images in one rich-media delivery.
RICH_MEDIA_MAX_IMAGES=8
# Maximum allowed size of an individual image, in bytes.
RICH_MEDIA_MAX_IMAGE_BYTES=4194304
# Timeout for each rich image download, in seconds.
RICH_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=3
# Total time budget for rich-media delivery, in seconds.
RICH_MEDIA_TOTAL_TIMEOUT_SECONDS=7
# Maximum concurrent image downloads.
RICH_MEDIA_MAX_DOWNLOADS=8
# Maximum concurrent local image uploads.
RICH_MEDIA_MAX_LOCAL_DELIVERIES=2
# Maximum allowed HTTP redirects for image retrieval.
RICH_MEDIA_MAX_REDIRECTS=4

# -----------------------------------------------------------------------------
# 07. Rich media caches and cleanup
# -----------------------------------------------------------------------------
# Budgets for retained images and failed delivery attempts. Disk paths must remain under the project directory.
# Retained RAM image cache limit, in bytes; zero disables retention.
RICH_MEDIA_RAM_CACHE_BYTES=16777216
# Disk image cache size limit, in bytes.
RICH_MEDIA_DISK_CACHE_BYTES=268435456
# Media cache entry lifetime, in seconds.
RICH_MEDIA_CACHE_TTL_SECONDS=86400
# Disk cache path relative to the project root.
RICH_MEDIA_DISK_DIR=data/runtime/rich-media
# Lifetime of remembered failed image URLs, in seconds.
RICH_MEDIA_FAILED_URL_TTL_SECONDS=120
# Lifetime of remembered failed delivery methods, in seconds.
RICH_MEDIA_FAILED_METHOD_TTL_SECONDS=180
# Maximum remembered image delivery failures.
RICH_MEDIA_FAILURE_CACHE_ENTRIES=2048
# Maximum number of cached RAM images.
RICH_MEDIA_RAM_CACHE_ENTRIES=2048
# Minimum interval between disk cache cleanup passes, in seconds.
RICH_MEDIA_DISK_PRUNE_INTERVAL_SECONDS=60
