TELEGRAM_ID_URL_NOTIFY=https://notify.moe/anime/{id}
TELEGRAM_ID_URL_OTAKOTAKU=https://otakotaku.com/anime/view/{id}
TELEGRAM_ID_URL_PRIMEVIDEO_TITLE=https://www.primevideo.com/detail/{id}
TELEGRAM_ID_URL_SHIKIMORI=https://shikimori.one/animes/{id}
TELEGRAM_ID_URL_SHOBOI=https://cal.syoboi.jp/tid/{id}
