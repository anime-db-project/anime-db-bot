# =============================================================================
# storage.env - Persistent user data and local cache
# =============================================================================
# English is the project's default documentation and configuration language.
# Template only; copy desired keys to .env.d/storage.env and restart the bot.
# Do not define the same key in both .env and .env.d files.

# -----------------------------------------------------------------------------
# 01. Persistent database backend
# -----------------------------------------------------------------------------
# SQLite is the default. PostgreSQL is optional for user settings, known users, bans and image-search quotas. Mappings, downloaded source databases and IMDb remain SQLite.
# Example DSN: postgresql://user:password@127.0.0.1:5432/anime_db_bot
# Durable data store: sqlite (default) or postgres.
DATABASE_BACKEND=sqlite
# PostgreSQL DSN, needed only for PostgreSQL mode or migration; keep private.
DATABASE_URL=
# Maximum connections in the PostgreSQL pool.
DATABASE_POOL_SIZE=5

# -----------------------------------------------------------------------------
# 02. Local SQLite paths
# -----------------------------------------------------------------------------
# Leave optional file overrides blank to use the built-in paths.
# Optional SQLite path for user ban records.
BANS_DB_PATH=
# Optional SQLite path for user preferences.
USER_SETTINGS_DB_PATH=
# SQLite path for image-search quotas.
IMAGE_SEARCH_DB_PATH=data/image_search.sqlite3

# -----------------------------------------------------------------------------
# 03. In-memory user caching
# -----------------------------------------------------------------------------
# Applies to user state when either SQLite or PostgreSQL is selected.
# Maximum cached user locale/known-user records.
USER_LOCALE_CACHE_MAX_ENTRIES=20000
# Lifetime of cached user locale data, in seconds.
USER_LOCALE_CACHE_TTL_SECONDS=120
# Minimum interval between last-seen writes for a user, in seconds.
USER_SEEN_WRITE_INTERVAL_SECONDS=300

# -----------------------------------------------------------------------------
# 04. Default interface language
# -----------------------------------------------------------------------------
# English (en) is the project default. ru, ja, de, es, fr and it are additional selectable languages.
# Default user interface language. English (en) unless explicitly changed.
USER_DEFAULT_LOCALE=en
