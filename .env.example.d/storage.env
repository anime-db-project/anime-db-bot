# Persistent mutable application records. SQLite is the safe default.
# PostgreSQL stores user settings, known users, bans and image-search quotas.
# Mapping catalog, downloaded source databases and IMDb dumps remain SQLite.
DATABASE_BACKEND=sqlite
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/anime_db_bot
DATABASE_URL=
DATABASE_POOL_SIZE=5

BANS_DB_PATH=
USER_SETTINGS_DB_PATH=
IMAGE_SEARCH_DB_PATH=data/image_search.sqlite3

# Local user preferences/known-users cache (applies to SQLite and PostgreSQL).
USER_LOCALE_CACHE_MAX_ENTRIES=20000
USER_LOCALE_CACHE_TTL_SECONDS=120
USER_SEEN_WRITE_INTERVAL_SECONDS=300
